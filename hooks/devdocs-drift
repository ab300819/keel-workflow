#!/bin/bash
# devdocs-drift — PostToolUse 提示：改了代码但 docs/devdocs/ 没动。
#
# 2026-09-16 起试验，真实会话触发已验证（见 README.md § 状态）后转正。
# 只做提示、不拦操作；背景见 docs/audits/2026-08-28-skill-soft-trigger-miss-brief.md
set -u
# ⛔ 本目录禁用 timeout(1)：macOS 默认没有，失败会静默吞掉输入。见 README.md

ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
# 只有目录不算 keel 项目：认基线或需求文档（基线项目无 01，见 pipeline 路由表）
[ -f "$ROOT/docs/devdocs/00-baseline.md" ] || [ -f "$ROOT/docs/devdocs/01-requirements.md" ] || exit 0
# ⛔ 不写死 $ROOT/.git：worktree 与子模块里 .git 是文件，stamp 写不进去会让冷却失效
GITDIR=$(git -C "$ROOT" rev-parse --absolute-git-dir 2>/dev/null) || exit 0

# 5 分钟冷却——PostToolUse 每次工具调用都触发，不冷却必然变噪声
STAMP="$GITDIR/devdocs-drift.stamp"
now=$(date +%s)
last=$(stat -f %m "$STAMP" 2>/dev/null || stat -c %Y "$STAMP" 2>/dev/null || echo 0)
[ $((now - last)) -lt 300 ] && exit 0

# 用 -z：各条目以 NUL 分隔、路径不加引号不转义，⛔ 不靠拆 " -> " 或去引号猜边界（文件名里可以有箭头和空格）。
# 重命名/复制条目是「XY 新路径」后面紧跟一条「旧路径」，取新的、跳过旧的。
CHANGED=$(git -C "$ROOT" status --porcelain -z --ignore-submodules=untracked 2>/dev/null | tr '\0' '\n' \
  | awk 'skip{skip=0; next} {print substr($0,4); if (substr($0,1,2) ~ /[RC]/) skip=1}')
[ -n "$CHANGED" ] || exit 0
printf '%s\n' "$CHANGED" | grep -q '^docs/devdocs/' && exit 0   # 文档已跟上，不提示

CODE=$(printf '%s\n' "$CHANGED" | grep -vE '^docs/|\.md$' | head -3 | tr -d '"\\' | tr '\n' ' ')
[ -n "$CODE" ] || exit 0                                    # 只改了文档，不提示

touch "$STAMP"
printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"ℹ️ devdocs-drift: 已改代码（%s）但 docs/devdocs/ 未变动。若这些改动对应任务卡，收尾跑 /sync。"}}\n' "${CODE% }"
exit 0
