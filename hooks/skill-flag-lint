#!/bin/bash
# skill-flag-lint — PostToolUse：编辑 skills/ 下的 .md 后跑 flag/dangling-reference。
#
# 只在 **skill 库自身**的仓库里生效（用户 keel 项目走 devdocs-drift，那是另一件事）。
# 规则与已知盲区见 skills/pipeline/references/health-lint-implementation.md
# 根因见 docs/audits/2026-09-11-devdocs-flow-backlog.md §4.1
set -u

ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
LINT="$ROOT/skills/pipeline/scripts/health-lint.py"
[ -f "$LINT" ] || exit 0                                    # 不是本仓，静默

# stdin 限时读——⛔ 不用 timeout(1)，macOS 默认没有，失败会静默吞掉 payload
PAYLOAD=""
if [ ! -t 0 ]; then
  while IFS= read -r line; do PAYLOAD="$PAYLOAD$line"; done <<< "$(cat 2>/dev/null)"
fi
EDITED=$(printf '%s' "$PAYLOAD" | python3 -c \
  'import json,sys
try: print(json.load(sys.stdin).get("tool_input",{}).get("file_path",""))
except Exception: print("")' 2>/dev/null)
case "$EDITED" in *"/skills/"*.md) ;; *) exit 0 ;; esac     # 只关心 skills/ 下的 .md

STAMP="$ROOT/.git/skill-flag-lint.stamp"
now=$(date +%s)
last=$(stat -f %m "$STAMP" 2>/dev/null || stat -c %Y "$STAMP" 2>/dev/null || echo 0)
[ $((now - last)) -lt 120 ] && exit 0                       # 2 分钟冷却

OUT=$(python3 "$LINT" --skills-dir "$ROOT/skills" 2>/dev/null) || true
[ -n "$OUT" ] || exit 0

touch "$STAMP"
MSG=$(printf '%s' "$OUT" | grep '^  message:' | sed 's/^  message: //;s/"//g' | head -5 | tr '\n' ' ' | tr -d '\\')
printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"⚠️ flag/dangling-reference: %s（反例请加 health-lint-disable-line 注释）"}}\n' "$MSG"
exit 0
